---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="about" class="border-b border-line" aria-labelledby="about-heading">
  <div
    class="reveal mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-12"
  >
    <div class="lg:col-span-4">
      <h2 id="about-heading" class="font-serif text-3xl tracking-tight text-ink">
        {t.about.heading}
      </h2>
    </div>
    <div class="max-w-2xl space-y-5 text-[1.05rem] text-muted lg:col-span-8">
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
      <ul class="flex flex-wrap gap-x-6 gap-y-1 pt-2 font-mono text-sm">
        {
          t.about.spoken.map((lang) => (
            <li>
              <span class="text-ink">{lang.name}</span>
              <span class="text-muted"> — {lang.level}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
