---
import { locales, localeMeta, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

function switchPath(next: Locale) {
  const parts = pathname.split("/").filter(Boolean);
  if (parts[0] && (locales as readonly string[]).includes(parts[0])) {
    parts[0] = next;
    return `/${parts.join("/")}/`.replace(/\/\/+/g, "/");
  }
  return `/${next}/`;
}
---

<nav class="flex items-center gap-1" aria-label={localeMeta[locale].label}>
  {
    locales.map((code) => {
      const active = code === locale;
      return (
        <a
          href={switchPath(code)}
          hreflang={localeMeta[code].htmlLang}
          lang={localeMeta[code].htmlLang}
          aria-current={active ? "true" : undefined}
          class:list={[
            "px-2 py-1 text-xs font-medium no-underline transition-colors",
            active
              ? "bg-ink text-paper"
              : "text-muted hover:text-ink hover:bg-surface",
          ]}
        >
          {localeMeta[code].short}
          <span class="sr-only"> — {localeMeta[code].label}</span>
        </a>
      );
    })
  }
</nav>
