---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section
  id="skills"
  class="border-b border-line"
  aria-labelledby="skills-heading"
>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="reveal max-w-2xl">
      <h2 id="skills-heading" class="font-serif text-3xl tracking-tight text-ink">
        {t.skills.heading}
      </h2>
      {t.skills.intro && <p class="mt-3 text-muted">{t.skills.intro}</p>}
    </div>
    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.skills.groups.map((group) => (
          <div class="reveal">
            <h3 class="font-mono text-xs tracking-[0.16em] text-accent uppercase">
              {group.name}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="skill-chip border border-line bg-surface px-2.5 py-1 text-sm text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
