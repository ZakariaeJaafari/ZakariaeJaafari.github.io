---
import { skills } from "../data/skills";
---

<section
  id="skills"
  class="border-b border-line"
  aria-labelledby="skills-heading"
>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="max-w-2xl">
      <h2 id="skills-heading" class="font-serif text-3xl tracking-tight text-ink">
        Skills
      </h2>
      <p class="mt-3 text-muted">
        Taken from my CV and from public repositories. Kafka, Redis, JWT and
        GitHub Actions appear because they are in
        <a href="/projects/chantiepro" class="text-accent no-underline hover:underline"
          >ChantiePro</a
        >; they are not claimed as day-to-day tools at every employer.
      </p>
    </div>
    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((group) => (
          <div>
            <h3 class="font-mono text-xs tracking-[0.16em] text-accent uppercase">
              {group.name}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="border border-line bg-surface px-2.5 py-1 text-sm text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
