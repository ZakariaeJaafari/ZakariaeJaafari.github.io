---
import { projects } from "../data/projects";
import type { Dictionary, Locale } from "../i18n";

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
---

<section
  id="projects"
  class="border-b border-line"
  aria-labelledby="projects-heading"
>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="reveal max-w-2xl">
      <h2
        id="projects-heading"
        class="font-serif text-3xl tracking-tight text-ink"
      >
        {t.projects.heading}
      </h2>
      <p class="mt-3 text-muted">{t.projects.intro}</p>
    </div>
    <ul class="mt-10 grid gap-6">
      {
        projects.map((project) => {
          const copy = t.projectPages[project.slug];
          return (
            <li class="project-card reveal border border-line bg-surface p-6 sm:p-8">
              {
                project.screenshots?.[0] && (
                  <a
                    href={`/${locale}/projects/${project.slug}/`}
                    class="mb-5 block overflow-hidden border border-line"
                  >
                    <img
                      src={project.screenshots[0].src}
                      alt={project.screenshots[0].alt}
                      class="aspect-[16/9] w-full object-cover object-top"
                      loading="lazy"
                    />
                  </a>
                )
              }
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="font-serif text-2xl text-ink">
                  <a
                    href={`/${locale}/projects/${project.slug}/`}
                    class="text-ink no-underline hover:text-accent"
                  >
                    {project.name}
                  </a>
                </h3>
                <p class="font-mono text-xs tracking-wide text-muted uppercase">
                  {copy.role}
                  {project.year ? ` · ${project.year}` : ""}
                </p>
              </div>
              <p class="mt-3 max-w-3xl text-[1.05rem] text-muted">
                {copy.oneLiner}
              </p>
              <p class="mt-4 font-mono text-xs leading-relaxed text-muted">
                {project.stack.join(" · ")}
              </p>
              <div class="mt-6 flex flex-wrap gap-4 text-sm">
                <a
                  href={`/${locale}/projects/${project.slug}/`}
                  class="text-accent no-underline hover:underline"
                >
                  {t.projects.details}
                </a>
                <a
                  href={project.github}
                  class="text-muted no-underline hover:text-ink"
                  rel="noopener noreferrer"
                >
                  {t.projects.github}
                </a>
                {project.demo && (
                  <a
                    href={project.demo}
                    class="text-muted no-underline hover:text-ink"
                    rel="noopener noreferrer"
                  >
                    {t.projects.demo}
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
