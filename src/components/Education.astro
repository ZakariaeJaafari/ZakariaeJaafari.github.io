---
import { certifications, education } from "../data/education";
---

<section
  id="education"
  class="border-b border-line"
  aria-labelledby="education-heading"
>
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2
        id="education-heading"
        class="font-serif text-3xl tracking-tight text-ink"
      >
        Education
      </h2>
      <ol class="mt-8 divide-y divide-line">
        {
          education.map((item) => (
            <li class="py-5">
              <p class="font-mono text-xs text-muted">
                {item.start} — {item.end}
              </p>
              <h3 class="mt-1 font-serif text-xl text-ink">{item.title}</h3>
              <p class="text-muted">
                {item.school}
                <span> — {item.location}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="lg:col-span-5">
      <h2
        id="certifications-heading"
        class="font-serif text-3xl tracking-tight text-ink"
      >
        Certifications
      </h2>
      <ol class="mt-8 divide-y divide-line" aria-labelledby="certifications-heading">
        {
          certifications.map((item) => (
            <li class="py-5">
              <p class="font-mono text-xs text-muted">{item.date}</p>
              <h3 class="mt-1 font-serif text-xl text-ink">{item.title}</h3>
              <p class="text-muted">
                {item.issuer} — {item.location}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
