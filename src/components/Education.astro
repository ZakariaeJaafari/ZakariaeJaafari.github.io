---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section
  id="education"
  class="border-b border-line"
  aria-labelledby="education-heading"
>
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12">
    <div class="reveal lg:col-span-7">
      <h2
        id="education-heading"
        class="font-serif text-3xl tracking-tight text-ink"
      >
        {t.education.heading}
      </h2>
      <ol class="mt-8 divide-y divide-line">
        {
          t.education.items.map((item) => (
            <li class="py-5">
              <p class="font-mono text-xs text-muted">
                {item.start} — {item.end}
              </p>
              <h3 class="mt-1 font-serif text-xl text-ink">{item.title}</h3>
              <p class="text-muted">
                {item.school}
                <span> — {item.location}</span>
              </p>
              {item.note && <p class="text-sm text-muted">{item.note}</p>}
            </li>
          ))
        }
      </ol>
    </div>
    <div class="reveal lg:col-span-5">
      <h2
        id="certifications-heading"
        class="font-serif text-3xl tracking-tight text-ink"
      >
        {t.education.certsHeading}
      </h2>
      <ol
        class="mt-8 divide-y divide-line"
        aria-labelledby="certifications-heading"
      >
        {
          t.education.certs.map((item) => (
            <li class="py-5">
              <p class="font-mono text-xs text-muted">{item.date}</p>
              <h3 class="mt-1 font-serif text-xl text-ink">{item.title}</h3>
              <p class="text-muted">{item.issuer}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
