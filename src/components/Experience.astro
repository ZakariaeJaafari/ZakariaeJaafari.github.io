---
import { roleStacks } from "../data/stacks";
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section
  id="experience"
  class="border-b border-line"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <h2
      id="experience-heading"
      class="reveal font-serif text-3xl tracking-tight text-ink"
    >
      {t.experience.heading}
    </h2>
    <ol class="mt-10 space-y-0 divide-y divide-line">
      {
        t.experience.roles.map((role) => (
          <li class="reveal grid gap-6 py-10 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class="font-mono text-xs tracking-wide text-muted uppercase">
                {role.start} — {role.end}
              </p>
              <h3 class="mt-2 font-serif text-2xl leading-snug text-ink">
                {role.title}
              </h3>
              <p class="mt-1 text-accent">
                {role.company}
                <span class="text-muted"> — {role.location}</span>
              </p>
            </div>
            <div class="lg:col-span-8">
              {role.summary && (
                <p class="mb-4 text-[1.02rem] text-muted">{role.summary}</p>
              )}
              <ul class="list-disc space-y-2 ps-5 text-[1.02rem] text-muted marker:text-accent">
                {role.bullets.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="mt-5 font-mono text-xs leading-relaxed text-muted">
                <span class="text-ink">{t.experience.environment}: </span>
                {(roleStacks[role.id] ?? []).join(" · ")}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
