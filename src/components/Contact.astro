---
import { site } from "../data/site";
import { cvFiles, type Dictionary, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;

function cvLabel(code: "EN" | "FR") {
  const file = cvFiles.find((f) => f.code === code);
  if (!file) return code;
  if (locale === "fr") return file.labelFr;
  if (locale === "ar") return file.labelAr;
  return file.labelEn;
}
---

<section
  id="contact"
  class="border-b border-line"
  aria-labelledby="contact-heading"
>
  <div class="reveal mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <h2 id="contact-heading" class="font-serif text-3xl tracking-tight text-ink">
      {t.contact.heading}
    </h2>
    <p class="mt-3 max-w-xl text-muted">{t.contact.intro}</p>
    <address class="mt-8 not-italic">
      <ul class="space-y-3 text-[1.05rem]">
        <li>
          <span class="font-mono text-xs tracking-wide text-muted uppercase"
            >{t.contact.email}</span
          >
          <div>
            <a
              href={`mailto:${site.email}`}
              class="text-accent no-underline hover:underline">{site.email}</a
            >
          </div>
        </li>
        <li>
          <span class="font-mono text-xs tracking-wide text-muted uppercase"
            >{t.contact.phone}</span
          >
          <div>
            <a
              href={site.phoneHref}
              class="text-accent no-underline hover:underline">{site.phone}</a
            >
          </div>
        </li>
        <li>
          <span class="font-mono text-xs tracking-wide text-muted uppercase"
            >{t.contact.linkedin}</span
          >
          <div>
            <a
              href={site.linkedin}
              class="text-accent no-underline hover:underline"
              rel="me noopener noreferrer">linkedin.com/in/jaafarizakariae</a
            >
          </div>
        </li>
        <li>
          <span class="font-mono text-xs tracking-wide text-muted uppercase"
            >{t.contact.github}</span
          >
          <div>
            <a
              href={site.github}
              class="text-accent no-underline hover:underline"
              rel="me noopener noreferrer">github.com/ZakariaeJaafari</a
            >
          </div>
        </li>
      </ul>
    </address>
    <p class="mt-8 font-mono text-xs tracking-wide text-muted uppercase">
      {t.contact.cvVersions}
    </p>
    <div class="mt-3 flex flex-wrap gap-3">
      {
        cvFiles.map((file) => (
          <a
            href={file.href}
            class="inline-flex items-center border border-ink px-4 py-2.5 text-sm font-medium text-ink no-underline transition-colors hover:bg-ink hover:text-paper"
            download
          >
            {t.nav.cv} ({cvLabel(file.code)})
          </a>
        ))
      }
    </div>
  </div>
</section>
