---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Architecture from "../../../components/Architecture.astro";
import { projects } from "../../../data/projects";
import { getDictionary, locales, localeFromParam } from "../../../i18n";

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, slug: project.slug },
      props: { project },
    })),
  );
}

const locale = localeFromParam(Astro.params.lang);
const t = getDictionary(locale);
const { project } = Astro.props;
const copy = t.projectPages[project.slug];
const title = `${project.name} — ${t.hero.title}`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={copy.oneLiner}
  path={`/${locale}/projects/${project.slug}/`}
  ogType="article"
>
  <article class="border-b border-line">
    <header class="border-b border-line">
      <div class="reveal mx-auto max-w-6xl px-5 py-14 sm:px-8">
        <p class="font-mono text-xs tracking-wide text-muted uppercase">
          <a
            href={`/${locale}/#projects`}
            class="text-muted no-underline hover:text-ink">{t.projects.crumb}</a
          >
          <span aria-hidden="true"> / </span>
          {copy.role}
        </p>
        <h1 class="mt-3 font-serif text-4xl tracking-tight text-ink sm:text-5xl">
          {project.name}
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-muted">{copy.oneLiner}</p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm">
          <a
            href={project.github}
            class="inline-flex border border-ink px-3 py-1.5 text-ink no-underline transition-colors hover:bg-ink hover:text-paper"
            rel="noopener noreferrer"
          >
            {t.projects.source}
          </a>
          {
            project.demo && (
              <a
                href={project.demo}
                class="inline-flex border border-line px-3 py-1.5 text-ink no-underline hover:border-ink"
                rel="noopener noreferrer"
              >
                {t.projects.demo}
              </a>
            )
          }
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="prose-page max-w-2xl space-y-8 lg:col-span-8">
          <section class="reveal" aria-labelledby="overview-heading">
            <h2 id="overview-heading" class="font-serif text-2xl text-ink">
              {t.projects.overview}
            </h2>
            <p class="mt-3 text-[1.05rem] text-muted">{copy.description}</p>
          </section>
          {
            project.screenshots && project.screenshots.length > 0 && (
              <section class="reveal" aria-labelledby="screenshots-heading">
                <h2 id="screenshots-heading" class="font-serif text-2xl text-ink">
                  {t.projects.screenshots}
                </h2>
                <div class="mt-4 grid gap-4">
                  {project.screenshots.map((shot) => (
                    <figure class="border border-line bg-surface">
                      <img
                        src={shot.src}
                        alt={shot.alt}
                        class="w-full"
                        loading="lazy"
                      />
                    </figure>
                  ))}
                </div>
              </section>
            )
          }
          <section class="reveal" aria-labelledby="problem-heading">
            <h2 id="problem-heading" class="font-serif text-2xl text-ink">
              {t.projects.problem}
            </h2>
            <p class="mt-3 text-[1.05rem] text-muted">{copy.problem}</p>
          </section>
          <section class="reveal" aria-labelledby="solution-heading">
            <h2 id="solution-heading" class="font-serif text-2xl text-ink">
              {t.projects.solution}
            </h2>
            <p class="mt-3 text-[1.05rem] text-muted">{copy.solution}</p>
          </section>
          {
            project.slug === "chantiepro" && (
              <section class="reveal" aria-labelledby="architecture-heading">
                <h2
                  id="architecture-heading"
                  class="mb-4 font-serif text-2xl text-ink"
                >
                  {t.projects.architecture}
                </h2>
                <Architecture t={t} />
              </section>
            )
          }
          <section class="reveal" aria-labelledby="features-heading">
            <h2 id="features-heading" class="font-serif text-2xl text-ink">
              {t.projects.inRepo}
            </h2>
            <ul class="mt-3 list-disc space-y-2 ps-5 text-[1.05rem] text-muted marker:text-accent">
              {copy.features.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
          {
            copy.decisions && (
              <section class="reveal" aria-labelledby="decisions-heading">
                <h2 id="decisions-heading" class="font-serif text-2xl text-ink">
                  {t.projects.decisions}
                </h2>
                <dl class="mt-4 space-y-5">
                  {copy.decisions.map((d) => (
                    <div>
                      <dt class="font-medium text-ink">{d.title}</dt>
                      <dd class="mt-1 text-muted">{d.body}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )
          }
        </div>
        <aside class="reveal lg:col-span-4">
          <div class="border border-line bg-surface p-5">
            <h2 class="font-mono text-xs tracking-wide text-muted uppercase">
              {t.projects.technologies}
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                project.stack.map((tech) => (
                  <li class="border border-line bg-paper px-2 py-1 text-sm">
                    {tech}
                  </li>
                ))
              }
            </ul>
            <h2 class="mt-6 font-mono text-xs tracking-wide text-muted uppercase">
              {t.projects.links}
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              <li>
                <a
                  href={project.github}
                  class="text-accent no-underline hover:underline"
                  rel="noopener noreferrer">{t.projects.source}</a
                >
              </li>
              {
                project.demo && (
                  <li>
                    <a
                      href={project.demo}
                      class="text-accent no-underline hover:underline"
                      rel="noopener noreferrer"
                    >
                      {t.projects.demo}
                    </a>
                  </li>
                )
              }
              <li>
                <a
                  href={`/${locale}/#projects`}
                  class="text-muted no-underline hover:text-ink"
                >
                  {t.projects.all}
                </a>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
