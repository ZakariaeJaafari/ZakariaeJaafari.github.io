---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Architecture from "../../components/Architecture.astro";
import { projects, type Project } from "../../data/projects";
import { site } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const title = `${project.name} — ${site.name}`;
const description = project.oneLiner;

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.name,
  description: project.description,
  codeRepository: project.github,
  url: new URL(`/projects/${project.slug}`, site.url).href,
  programmingLanguage: project.stack[0],
  author: {
    "@type": "Person",
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path={`/projects/${project.slug}/`}
  ogType="article"
>
  <article class="border-b border-line">
    <header class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
        <p class="font-mono text-xs tracking-wide text-muted uppercase">
          <a href="/#projects" class="text-muted no-underline hover:text-ink"
            >Projects</a
          >
          <span aria-hidden="true"> / </span>
          {project.role}
        </p>
        <h1 class="mt-3 font-serif text-4xl tracking-tight text-ink sm:text-5xl">
          {project.name}
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-muted">{project.oneLiner}</p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm">
          <a
            href={project.github}
            class="inline-flex border border-ink px-3 py-1.5 text-ink no-underline hover:bg-ink hover:text-paper"
            rel="noopener noreferrer"
          >
            View on GitHub
          </a>
          {
            project.demo && (
              <a
                href={project.demo}
                class="inline-flex border border-line px-3 py-1.5 text-ink no-underline hover:border-ink"
                rel="noopener noreferrer"
              >
                {project.demoLabel ?? "Live demo"}
              </a>
            )
          }
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="prose-page max-w-2xl space-y-8 lg:col-span-8">
          <section aria-labelledby="overview-heading">
            <h2
              id="overview-heading"
              class="font-serif text-2xl text-ink"
            >
              Overview
            </h2>
            <p class="mt-3 text-[1.05rem] text-muted">{project.description}</p>
          </section>

          <section aria-labelledby="problem-heading">
            <h2 id="problem-heading" class="font-serif text-2xl text-ink">
              Problem
            </h2>
            <p class="mt-3 text-[1.05rem] text-muted">{project.problem}</p>
          </section>

          <section aria-labelledby="solution-heading">
            <h2 id="solution-heading" class="font-serif text-2xl text-ink">
              Technical solution
            </h2>
            <p class="mt-3 text-[1.05rem] text-muted">{project.solution}</p>
          </section>

          {
            project.slug === "chantiepro" && (
              <section aria-labelledby="architecture-heading">
                <h2
                  id="architecture-heading"
                  class="mb-4 font-serif text-2xl text-ink"
                >
                  Architecture
                </h2>
                <Architecture />
              </section>
            )
          }

          <section aria-labelledby="features-heading">
            <h2 id="features-heading" class="font-serif text-2xl text-ink">
              What is in the repository
            </h2>
            <ul
              class="mt-3 list-disc space-y-2 pl-5 text-[1.05rem] text-muted marker:text-accent"
            >
              {project.features.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>

          {
            project.decisions && (
              <section aria-labelledby="decisions-heading">
                <h2 id="decisions-heading" class="font-serif text-2xl text-ink">
                  Technical decisions
                </h2>
                <dl class="mt-4 space-y-5">
                  {project.decisions.map((d) => (
                    <div>
                      <dt class="font-medium text-ink">{d.title}</dt>
                      <dd class="mt-1 text-muted">{d.body}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )
          }
        </div>

        <aside class="lg:col-span-4">
          <div class="border border-line bg-surface p-5">
            <h2 class="font-mono text-xs tracking-wide text-muted uppercase">
              Technologies
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                project.stack.map((tech) => (
                  <li class="border border-line bg-paper px-2 py-1 text-sm">
                    {tech}
                  </li>
                ))
              }
            </ul>
            <h2
              class="mt-6 font-mono text-xs tracking-wide text-muted uppercase"
            >
              Links
            </h2>
            <ul class="mt-3 space-y-2 text-sm">
              <li>
                <a
                  href={project.github}
                  class="text-accent no-underline hover:underline"
                  rel="noopener noreferrer">Source on GitHub</a
                >
              </li>
              {
                project.demo && (
                  <li>
                    <a
                      href={project.demo}
                      class="text-accent no-underline hover:underline"
                      rel="noopener noreferrer"
                    >
                      {project.demoLabel ?? "Live demo"}
                    </a>
                  </li>
                )
              }
              <li>
                <a href="/#projects" class="text-muted no-underline hover:text-ink"
                  >All featured projects</a
                >
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareJsonLd)}
  />
</BaseLayout>
