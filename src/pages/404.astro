---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="This page does not exist."
  path="/404"
>
  <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <p class="font-mono text-xs tracking-wide text-muted uppercase">404</p>
    <h1 class="mt-3 font-serif text-4xl text-ink">This page is not here.</h1>
    <p class="mt-4 max-w-md text-muted">
      The address may have changed, or it was never published.
    </p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex border border-ink px-4 py-2.5 text-sm text-ink no-underline hover:bg-ink hover:text-paper"
      >
        Back to the homepage
      </a>
    </p>
  </section>
</BaseLayout>
