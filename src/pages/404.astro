---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDictionary, localeFromParam } from "../i18n";

const first = Astro.url.pathname.split("/").filter(Boolean)[0];
const locale = localeFromParam(first);
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.notFound.title} path={`/${locale}/404/`}>
  <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <p class="font-mono text-xs tracking-wide text-muted uppercase">404</p>
    <h1 class="mt-3 font-serif text-4xl text-ink">{t.notFound.heading}</h1>
    <p class="mt-4 max-w-md text-muted">{t.notFound.body}</p>
    <p class="mt-8">
      <a
        href={`/${locale}/`}
        class="inline-flex border border-ink px-4 py-2.5 text-sm text-ink no-underline hover:bg-ink hover:text-paper"
      >
        {t.notFound.home}
      </a>
    </p>
  </section>
</BaseLayout>
